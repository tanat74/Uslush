# Telegram Bot Configuration
# Copy this file to .env and fill in the values

# -------------------------------------------------------
# BOT_TOKEN (обязательный)
# Токен аутентификации Telegram-бота.
# Получить у @BotFather: https://t.me/BotFather
# -------------------------------------------------------
BOT_TOKEN=your-telegram-bot-token-here

# -------------------------------------------------------
# WYOMING_HOST (обязательный) и WYOMING_PORT
# Адрес существующего сервера Wyoming/faster-whisper.
# Стандартный порт протокола — 10300.
# -------------------------------------------------------
WYOMING_HOST=wyoming.example
WYOMING_PORT=10300
WHISPER_LANGUAGE=ru

# Полное имя единственного опубликованного образа. Замените YOUR_GITHUB_USER.
#IMAGE_NAME=ghcr.io/YOUR_GITHUB_USER/uslush
#IMAGE_TAG=latest

# -------------------------------------------------------
# ALLOWED_USER_IDS (необязательный)
# Список Telegram user ID через запятую. Пустое значение —
# бот отвечает всем. Узнать свой ID можно у @userinfobot.
# -------------------------------------------------------
#ALLOWED_USER_IDS=123456789

# -------------------------------------------------------
# BOT_MODE (необязательный, по умолчанию: polling)
# Режим работы бота.
# Допустимые значения: polling | webhook
# -------------------------------------------------------
BOT_MODE=polling

# -------------------------------------------------------
# POLL_INTERVAL (необязательный, по умолчанию: 60)
# Пауза в секундах между запросами getUpdates в режиме polling.
# -------------------------------------------------------
#POLL_INTERVAL=60

# -------------------------------------------------------
# FFMPEG_TIMEOUT (необязательный, по умолчанию: 120)
# Максимальное время декодирования медиа в секундах.
# -------------------------------------------------------
#FFMPEG_TIMEOUT=120

# -------------------------------------------------------
# WYOMING_TIMEOUT (необязательный, по умолчанию: 300)
# Максимальное время ожидания ответа ASR-сервера в секундах.
# -------------------------------------------------------
#WYOMING_TIMEOUT=300

# -------------------------------------------------------
# WEBHOOK_URL (обязательный при BOT_MODE=webhook)
# Публичный HTTPS-URL, на который Telegram будет
# отправлять обновления.
# Пример: https://example.com/bot
# -------------------------------------------------------
#WEBHOOK_URL=https://example.com/bot

# -------------------------------------------------------
# WEBHOOK_PORT (необязательный, по умолчанию: 8443)
# Порт, на котором бот слушает входящие webhook-запросы.
# Telegram поддерживает порты: 443, 80, 88, 8443.
# -------------------------------------------------------
#WEBHOOK_PORT=8443
