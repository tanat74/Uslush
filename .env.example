# Токен Telegram от @BotFather
BOT_TOKEN=your-telegram-bot-token-here

# URL сервера GigaAM, доступный из контейнера бота, без /v1
GIGAAM_BASE_URL=http://gigaam.example:8770
#GIGAAM_MODEL=gigaam-v3-e2e-rnnt
#GIGAAM_API_KEY=
#GIGAAM_TIMEOUT=300

# ALLOWED_USER_IDS: пусто — разрешены все пользователи
#ALLOWED_USER_IDS=123456789
BOT_MODE=polling
#POLL_INTERVAL=60
#WEBHOOK_URL=https://example.com/bot
#WEBHOOK_PORT=8443

#IMAGE_NAME=ghcr.io/tanat74/uslush
#IMAGE_TAG=latest
